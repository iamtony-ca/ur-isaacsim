<?xml version="1.0"?>
<!--
  UR16e + dual-tool EOAT (set 4) top-level description for the Isaac Sim backend.
  Arm from the official ur_description macro; EOAT from the config-driven macro
  ur16e_dualtool_eoat_macro.xacro (GENERATED by isaac/common/eoat/build_eoat_moveit.py
  from eoat_dualtool.yaml — the single source that also emits the Isaac USD, so the
  MoveIt collision model matches the sim asset; 함정 #7).

  robot name MUST stay "ur16e" so ur_moveit_config's SRDF (via srdf/common/
  ur16e_dualtool.srdf.xacro -> <xacro:ur_srdf/>) applies.

  The EOAT mounts directly at tool0 (its first link `damper` is the mechanical
  damper/coupling). The Isaac-frame -90° tool0 vs wrist_3 offset lives ONLY in the
  Isaac USD (build_ur16e_dualtool.py); the URDF is authored in the clean ROS tool0
  frame, so no rotation is applied here.

  ros2_control exchanges only the driven finger (gripper_2fg14__finger_left_joint)
  with Isaac; the mirror finger follows via <mimic> (RSP) + the asset coupling.

  Pair with: launch/ur16e_dualtool/ur16e_dualtool.launch.py (TODO),
  config controllers yaml (TODO), and isaac/assets/ur16e_dualtool_full.usd.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur16e">
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="joint_commands_topic" default="/isaac_joint_commands"/>
  <xacro:arg name="joint_states_topic" default="/isaac_joint_states"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_bringup)/urdf/common/ur16e_dualtool_sim.ros2_control.xacro"/>
  <xacro:include filename="$(find ur_bringup)/urdf/ur16e_dualtool/ur16e_dualtool_eoat_macro.xacro"/>

  <link name="world"/>

  <xacro:ur_robot
    name="ur16e"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/ur16e/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur16e/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur16e/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur16e/visual_parameters.yaml">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- dual-tool EOAT mounted at tool0 (first link = damper). -->
  <xacro:ur16e_dualtool_eoat parent="$(arg tf_prefix)tool0" prefix="$(arg tf_prefix)"/>

  <xacro:ur16e_dualtool_sim_ros2_control
    name="ur16e"
    tf_prefix="$(arg tf_prefix)"
    joint_commands_topic="$(arg joint_commands_topic)"
    joint_states_topic="$(arg joint_states_topic)"/>
</robot>
